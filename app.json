{
  "expo": {
    "name": "Muslim Hub",
    "slug": "muslim-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "muslimhub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "rifqi.muslimhub",
      "supportsTablet": false
    },
    "android": {
      "package": "rifqi.muslimhub",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A1512",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1512",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Muslim Hub menggunakan lokasi untuk menampilkan jadwal shalat yang akurat sesuai area Anda."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Muslim Hub meminta izin untuk menyimpan wallpaper islami ke galeri Anda."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiKey": ""
    }
  }
}
